# LLM fallback (v1.1 Impressum çıkarımı için) — opsiyonel.
# Key yoksa uygulama çökmez, LLM adımı atlanır ve kayıt 'manual' işaretlenir.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
# Düz bilgi çıkarımı için ucuz "nano" sınıfı yeter. Kalite tatmin ederse
# gpt-5-nano'ya inip daha da ucuzlatabilirsin. Değiştirmek tek satır.
LLM_MODEL=gpt-4.1-nano
